# Copy to .env.local and fill in. Every key is optional:
# without it, that feature falls back to demo mode (see README).

# AI — conversation, reflections, memory. Set ONE of these.
# Claude (preferred when set)
ANTHROPIC_API_KEY=
# Or Google Gemini (free tier works; note Google may use free-tier content to improve its products)
GEMINI_API_KEY=
# Optional: Gemini model (default gemini-3.8-flash, falls back to gemini-2.5-flash)
GEMINI_MODEL=

# ElevenLabs — speech-to-text and text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Supabase — accounts and cloud storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: voices offered in Settings, as "voiceId:Name,voiceId:Name"
ELEVENLABS_VOICES=
# Optional model overrides
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2
