# Copy to .env.local and fill in. Every key is optional:
# without it, that feature falls back to demo mode (see README).

# Claude — conversation, reflections, memory
ANTHROPIC_API_KEY=

# ElevenLabs — speech-to-text and text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Supabase — accounts and cloud storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: voices offered in Settings, as "voiceId:Name,voiceId:Name"
ELEVENLABS_VOICES=
# Optional model overrides
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2
